{
  "schemaVersion": 1,
  "id": "org.fiex.git",
  "name": "Git",
  "version": "0.1.0",
  "protocolVersion": "1.0",
  "capabilities": [
    "filesystem",
    "toolbar",
    "commands",
    "panel"
  ],
  "entrypoints": {
    "windows-x86_64": "fiex-plugin-git.exe",
    "macos-aarch64": "fiex-plugin-git",
    "macos-x86_64": "fiex-plugin-git",
    "linux-x86_64": "fiex-plugin-git"
  },
  "contributes": {
    "toolbar": [
      {
        "id": "git.main",
        "title": "源代码管理",
        "icon": "git-branch",
        "command": "git.status"
      }
    ]
  }
}
