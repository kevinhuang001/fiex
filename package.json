{
  "name": "fiex",
  "version": "0.4.11",
  "private": true,
  "type": "module",
  "description": "A calm, fast file explorer for macOS, Windows and Linux.",
  "scripts": {
    "icons:files": "node scripts/sync-file-icons.mjs",
    "predev": "npm run icons:files",
    "prebuild": "npm run icons:files",
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:native": "node scripts/audit-native-deps.mjs",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "icons": "tauri icon assets/icon.png --output src-tauri/icons"
  },
  "dependencies": {
    "@crabnebula/tauri-plugin-drag": "2.1.0",
    "@phosphor-icons/react": "2.1.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-virtual": "^3.13.12",
    "@tauri-apps/api": "^2.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "highlight.js": "^11.12.0",
    "lucide-react": "^0.577.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@tailwindcss/vite": "^4.1.14",
    "@tauri-apps/cli": "^2.9.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "material-icon-theme": "^5.39.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.9.3",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  },
  "license": "GPL-3.0-or-later"
}
